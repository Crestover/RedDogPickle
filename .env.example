# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is git-ignored.
# See SETUP_GUIDE.md for where to find these values.

# Supabase project URL (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon / public key (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase service role key (server-only — NEVER expose to browser).
# Used only by the admin panel's server actions to bypass RLS for
# privileged writes (create group, toggle player visibility).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin panel — shared password + HMAC signing secret for the session
# cookie. Generate a long random string for ADMIN_SESSION_SECRET, e.g.
# `openssl rand -hex 32`. Required only if you use the admin panel.
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=change-me-too
